# OrderFlow environment configuration
# Copy to .env and fill in real values.

# --- Meteora Data API ---
# Base URL of the Meteora public REST API (read layer source).
METEORA_API_BASE=https://dlmm.datapi.meteora.ag

# --- RPC ---
# Solana RPC endpoint (Helius/QuickNode recommended for production).
RPC_ENDPOINT=https://api.mainnet-beta.solana.com
RPC_WSS=wss://api.mainnet-beta.solana.com

# --- Keeper (crank) ---
# Private key (base58) of the CRANK wallet. This is NOT a custodian: it only
# pays gas/rent and triggers pre-authorized `place_tranche`/`claim_fees`
# instructions. User funds live in on-chain vault PDAs under program control.
# `KEEPER_PRIVATE_KEY` is kept as a legacy alias.
CRANK_PRIVATE_KEY=
KEEPER_PRIVATE_KEY=
# How often the keeper checks active bins / claims (cron expression or ms).
KEEPER_INTERVAL_MS=30000
# Claim fees below this USD value instead of re-pinning.
CLAIM_THRESHOLD_USD=0.01

# Returned fees settle straight into the vault PDA (non-custodial).

# --- Order Signer Persistence ---
# Encrypted file path for persisting per-order signer keypairs.
SIGNER_STORE_FILE=./data/order-signers.json.enc
# 32-byte hex key for encrypting the order signer store.
SIGNER_STORE_KEY=

# --- Transaction Sending ---
# Run preflight before broadcasting (default: true).
SKIP_PREFLIGHT=false
# Max retries for failed sends.
SEND_MAX_RETRIES=3
# Base delay between retries in ms.
SEND_RETRY_DELAY_MS=1000

# --- Rebalance Guardrails ---
# Minimum milliseconds between rebalance operations per strategy.
REBALANCE_MAX_FREQUENCY_MS=3600000
# Maximum allowed slippage in basis points for rebalance.
REBALANCE_SLIPPAGE_BPS=100

# --- Alerting ---
# Webhook URL for keeper failure alerts (best-effort POST).
KEEPER_ALERT_WEBHOOK=

# --- Persistence ---
# Set to a Postgres connection string to use PostgresStrategyStore.
# Leave empty to use the JSON file store.
DATABASE_URL=

# --- API ---
# HTTP port for the read layer.
PORT=8080

# --- Web ---
# Where the web app talks to.
VITE_API_URL=http://localhost:8080
VITE_RPC_ENDPOINT=https://api.mainnet-beta.solana.com
VITE_METEORA_API_BASE=https://dlmm.datapi.meteora.ag
